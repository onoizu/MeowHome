{
  "name": "meowhome",
  "version": "1.0.0",
  "private": true,
  "description": "Cat adoption and rehoming web application",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:init": "node --env-file-if-exists=.env database/init.js",
    "test": "node --test tests/api.test.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
